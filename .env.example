# Copy this file to .env and fill in the values.
PORT=3000
SITE_NAME=Ljubica Bielikova — English Teacher, Language Auditor, Translator, Interpreter
INTERPRETER_NAME=Ljubica Bielikova
INTERPRETER_EMAIL=you@example.com

# Resend: https://resend.com
RESEND_API_KEY=
# Use a sender domain verified with Resend.
EMAIL_FROM=Website <website@your-verified-domain.com>

# OpenAI API key for the website chatbot.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limiting (in-memory, per IP). Defaults: 60s window, 5 requests.
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=5

# Set to "production" to trust X-Forwarded/X-Real-IP headers for client IP.
# NODE_ENV=production
